
<head>
  <title>Edit Profile</title>
  <link rel="stylesheet" href="/public/style.css">
  <style>
    nav a{
      text-decoration: none;
      color:#333;
    }
  </style>
</head>

<body>
  <nav>
    <button><a href="/profile">Back to Profile</a></button>
  </nav>

  <section class="edit-profile">
    <h1>Edit Your Profile</h1>
    <form action="/profile/edit" method="POST">
      
        &nbsp <label>Username:</label>
      <input type="text" name="username" value="<%= user.username %>" required>

      &nbsp<label>Email:</label>
      <input type="email" name="email" value="<%= user.email %>" disabled>

     &nbsp <label>Bio:</label>
      <textarea name="bio"> <%= user.bio || '' %></textarea>

      &nbsp<label>Change Password:</label>
      <input type="password" name="password" placeholder="Enter new password (optional)">

      <br><br><button type="submit">Save Changes</button>
    </form>
  </section>
</body>
