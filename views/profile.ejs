
<head>
  <title><%= user.username %> - Profile</title>
  <link rel="stylesheet" href="/public/style.css">
</head>

<body>
  <nav>
    <a href="/">Home</a>
    <a href="/login">Logout</a>
  </nav>

  <section class="profile-container">

    <% if(user) { %>
    <h1>👤 <%= user.username %></h1>
    <p><b>Email:</b> <%= user.email %></p>
    <p><b>Bio:</b> <%= user.bio || "No bio yet." %></p>
    <a href="/profile/edit">Edit Profile</a>
    <% } else { %>
      <p> user not found :(</p>
      <% } %>

       <h2>📝 Your Posts</h2>
    <% if (posts.length > 0) { %>
      <ul>
        <% posts.forEach(post => { %>
          <li>
            <a href="/posts/<%= post.post_id %>"><%= post.title %></a> &nbsp <a href='/posts/${post.post_id}/update'>update</a>
                 &nbsp <a href='/posts/${post.post_id}/'>delete</a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>You haven’t written any posts yet.</p>
       <% } %>
       &nbsp<a href="/new" class="btn"> Create a New Post</a>  &nbsp<a href="/posts" class="btn">View all posts</a>
       &nbsp<a href="/fyp" class="btn"> For You Page</a>


   

  </section>
</body>

