<html>
  <head>
    <title>Comments</title>
  </head>
  <body>
     <nav>
      <a href="/fyp">⬅️ back to fyp</a>
    </nav>
    <section class="post-section">
      <h2><%= post.title %></h2>
      <p><i>by <%= post.username %></i></p>
      <p><%= post.caption %></p>
      <hr>

      <h3>💬 Comments (<%= post.comments_count %>)</h3>

      <% if (comment.length > 0) { %>
        <ul>
          <% comment.forEach(x => { %>
            <li style="margin-bottom:10px;">
              <b><%= x.username %></b> 
              <small>• <%= new Date(x.created_at).toLocaleString() %></small>
              <br>
              <%= x.comment %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No comments yet. Be the first to comment!</p>
      <% } %>

      <hr>

      <form action="/comments/<%= post.post_id %>" method="POST">
        <textarea name="comment" rows="3"placeholder="Write your comment..."required></textarea> <br>
        <button type="submit">Post Comment</button>
      </form>
    </section>
  </body>
  </html>