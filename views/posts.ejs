<!DOCTYPE html>
<html>
  <head>
    <title>All Posts</title>
    <style>
    nav a{
      text-decoration: none;
      color:#333;
    }
  </style>
  </head>
  <body>
    <nav>
      <button><a href="/profile">My Profile</a></button>
      <button><a href="/new">Create Post</a></button>
    </nav>

    <section>
      <h1>All Posts</h1>
      <% posts.forEach(x =>{ %>
        <article style="border:1px solid #ccc; margin:15px; padding:10px;">
           <h2><%= x.title %></h2>
          <p><i>by <%= users.username %></i></p>
          <p>caption: <%= x.caption %></p>
          <p><%= x.content %></p>
          <% if (x.hashtags && x.hashtags.length) { %>
            <p>hashtags: <%= x.hashtags.join(", ") %></p>
          <% } %>
          <div>
            likes: <%= x.likes_count %> | comments: <%= x.comments_count %>
          </div>
        </article>
      <% }) %>
    </section>
  </body>
</html>
