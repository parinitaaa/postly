<!DOCTYPE html>
<html>
  <head>
    <title>All Posts</title>
  </head>
  <body>
    <nav>
      <a href="/profile">My Profile</a>
      <a href="/new">Create Post</a>
    </nav>

    <section>
      <h1>All Posts</h1>
      <% posts.forEach(post =>{ %>
        <article style="border:1px solid #ccc; margin:15px; padding:10px;">
          <h2><%= post.title %></h2>
          <p><i>by <%= users.username %></i></p>
          <p><%= post.caption %></p>
          <p><%= post.content %></p>
          <% if (post.hashtags && post.hashtags.length) { %>
            <p><%= post.hashtags.join(", ") %></p>
          <% } %>
          <div>
            ❤️ <%= post.likes_count %> | 💬 <%= post.comments_count %>
          </div>
        </article>
      <% }) %>
    </section>
  </body>
</html>
