
  <head>
    <title>Create Post</title>
  </head>
  <body>
    <nav>
      <a href="/profile">Back to Profile</a>
    </nav>

    <section>
       <% if (user) { %>
  <h1><%= user.username %></h1>
       <% } %>
      <strong><h3>Update a New Post</h3> </strong>
      <form action="/posts/<%=post.post_id%>/update" method="POST">
  <label>Title:</label><br>
  <input type="text" name="title" value="<%- post.title %>" required><br><br>

  <label>Caption:</label><br>
  <input type="text" name="caption" value="<%- post.caption || '' %>"><br><br>

  <label>Content:</label><br>
<textarea name="content" rows="6" required><%- post.content || '' %></textarea><br><br>


  <label>Hashtags (space separated):</label><br>
  <input type="text" name="hashtags" value="<%- post.hashtags ? post.hashtags.join(' ') : '' %>"><br><br>

  <button type="submit">Publish</button>
</form>
    </section>
  </body>

