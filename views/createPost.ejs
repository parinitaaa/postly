
  <head>
    <title>Create Post</title>
    <style>
    nav a{
      text-decoration: none;
      color:#333;
    }
  </style>
  </head>
  <body>
    <nav>
      <button><a href="/profile">Back to Profile</a></button>
    </nav>

    <section>
        <% if (user)  %>
  <h1><%= user.username %>'s <%= length %>th post </h1>
      <strong><h3>Create a New Post</h3> </strong>
      <form action="/new" method="POST">
        <label>Title:</label><br>
        <input type="text" name="title" required><br><br>

        <label>Caption:</label><br>
        <input type="text" name="caption" optional><br><br>

        <label>Content:</label><br>
        <textarea name="content" rows="6" required></textarea><br><br>

        <label>Hashtags: (space seperated)</label><br>
        <input type="text" name="hashtags" placeholder="#life #blog" optional><br><br>

        <button type="submit">Publish</button>
      </form>
    </section>
  </body>

